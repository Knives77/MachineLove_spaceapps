# Pegar al final de ~/.ssh/config de tu laptop (Windows: C:\Users\<usuario>\.ssh\config).
# Cambia IdentityFile por tu llave privada si no es la de por defecto.
#
# Uso (deja la terminal abierta mientras trabajas):
#   ssh -N machinelove-wifi      # por Wi-Fi
#   ssh -N machinelove-cable     # por cable directo
#
# La llave solo permite túneles: sin -N la conexión se cierra al instante.
# Postgres llega a tu laptop en 15432 para no chocar con un Postgres local.

Host machinelove-wifi machinelove
    HostName 10.61.5.140
    User equimanthorn
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    ExitOnForwardFailure yes
    LocalForward 8000 localhost:8000
    LocalForward 8001 localhost:8001
    LocalForward 15432 localhost:5432

Host machinelove-cable
    HostName 10.0.0.1
    User equimanthorn
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    IPQoS throughput
    ServerAliveInterval 30
    ExitOnForwardFailure yes
    LocalForward 8000 localhost:8000
    LocalForward 8001 localhost:8001
    LocalForward 15432 localhost:5432
